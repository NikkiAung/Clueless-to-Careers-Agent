{
  "manifest_version": 3,
  "name": "Clueless-to-Careers-Agent",
  "version": "2.0.0",
  "description": "AI-powered resume tailoring for job applications",
  "permissions": [
    "sidePanel",
    "declarativeNetRequestWithHostAccess",
    "contextMenus",
    "runtime",
    "scripting",
    "tabs",
    "activeTab"
  ],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_icon": {
      "16": "images/16x16.png",
      "32": "images/32x32.png",
      "48": "images/48x48.png",
      "128": "images/128x128.png"
    },
    "default_popup": "popup.html",
    "default_title": "Clueless-to-Careers-Agent"
  },
  "icons": {
    "128": "images/128x128.png",
    "16": "images/16x16.png",
    "32": "images/32x32.png",
    "48": "images/48x48.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+B",
        "mac": "Command+B"
      },
      "description": "Open Clueless-to-Careers-Agent"
    }
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "removeHeader",
        "enabled": true,
        "path": "removeHeader.json"
      }
    ]
  }
}
